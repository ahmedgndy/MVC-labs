@using MVc.Models
@model IEnumerable<Course>
@{
    ViewData["Title"] = "Courses";
}
<h1>Courses</h1>
<p><a class="btn btn-primary" asp-action="Create">Create New Course</a></p>

<table class="table table-striped">
    <thead>
        <tr><th>ID</th><th>Name</th><th>Credits</th><th>Instructors</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.Credits</td>
                <td>
                    @if (c.CourseInstructors != null && c.CourseInstructors.Any())
                    {
                        @string.Join(", ", c.CourseInstructors.Select(ci => ci.Instructor?.Name ?? ""))
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@c.Id">Details</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
