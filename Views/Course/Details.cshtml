@using MVc.Models
@model Course
@{
    ViewData["Title"] = "Course Details";
}
<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Id</dd>
    <dt class="col-sm-2">Credits</dt>
    <dd class="col-sm-10">@Model.Credits</dd>
    <dt class="col-sm-2">Instructors</dt>
    <dd class="col-sm-10">
        @if (Model.CourseInstructors != null && Model.CourseInstructors.Any())
        {
            <ul>
                @foreach (var ci in Model.CourseInstructors)
                {
                    <li>@ci.Instructor?.Name</li>
                }
            </ul>
        }
        else
        {

            <span class="text-muted">None assigned.</span>
        }
    </dd>
</dl>

<p>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to list</a>
</p>
