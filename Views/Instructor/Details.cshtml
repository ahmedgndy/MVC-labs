@using MVc.Models
@model Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<h1>@Model.Name</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Hire Date</dt>
        <dd class="col-sm-10">@Model.HireDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Office</dt>
        <dd class="col-sm-10">@Model.OfficeAssignment?.Location</dd>

        <dt class="col-sm-2">Courses</dt>
        <dd class="col-sm-10">
            @if (Model.CourseInstructors != null && Model.CourseInstructors.Any())
            {
                <ul>
                    @foreach (var ci in Model.CourseInstructors)
                    {
                        <li>@ci.Course?.Name</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No courses assigned.</span>
            }
        </dd>
    </dl>
</div>

<p>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to list</a>
</p>
