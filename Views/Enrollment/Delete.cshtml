@using MVc.Models
@model Enrollment
@{
    ViewData["Title"] = "Delete Enrollment";
}
<h2>Delete Enrollment</h2>
<p>Are you sure you want to delete this enrollment?</p>

<div>
    <strong>Student:</strong> @Model.Student?.Name <br />
    <strong>Course:</strong> @Model.Course?.Name <br />
    <strong>Grade:</strong> @Model.Grade
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger mt-3">Delete</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
