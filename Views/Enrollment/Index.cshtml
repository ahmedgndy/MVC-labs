@using MVc.Models
@model IEnumerable<Enrollment>
@{
    ViewData["Title"] = "Enrollments";
}
<h2>Enrollments</h2>
<p><a class="btn btn-primary" asp-action="Create">Add New Enrollment</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Grade</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Student?.Name</td>
                <td>@e.Course?.Name</td>
                <td>@e.Grade</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@e.Id">Details</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@e.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@e.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
