
@{
    Layout = "_layout";
  
    ViewData["Title"] = "About Us";
}

<!-- About Section -->
<section class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">About Us</h1>
        <p class="text-muted">Learn more about who we are and what we do</p>
    </div>

    <div class="row align-items-center">
        <div class="col-md-6">
            <img src="~/images/team.jpg" class="img-fluid rounded-4 shadow-sm" alt="Our Team" />
        </div>
        <div class="col-md-6">
            <h2 class="fw-semibold">Our Mission</h2>
            <p class="text-secondary">
                We are a passionate team dedicated to providing high-quality software solutions and digital experiences.
                Our mission is to help students and developers grow their skills and build modern, efficient, and reliable applications.
            </p>

            <h2 class="fw-semibold mt-4">Our Vision</h2>
            <p class="text-secondary">
                To empower every learner and developer to reach their full potential through innovation, creativity, and continuous learning.
            </p>
        </div>
    </div>
</section>