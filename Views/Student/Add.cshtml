@using MVc.Enums
@using MVc.ViewModels

@{
    Layout = "_layout";

    ViewData["Title"] = "Studend";
}
@{
    var addresses = Enum.GetValues(typeof(Branch));

}

@model StudentVM


<form class="m-5" action="/student/AddnewStudent" method="post">
    <div class="form-group">
        <label for="name">Name</label>
        <input type="text" class="form-control"  value="@Model?.Name"  id="email" aria-describedby="emailHelp" name="Name">
    </div>

    <div class="form-group">
        <label for="Age">Age</label>
        <input type="text" class="form-control" value="@Model?.Age"  id="email" name="age" required>
    </div>

    <div class="form-group">
        <label for="address">address</label>
        <select class="form-select" aria-label="Address"  name="Address"required>
            <option selected>
                @Model?.Address
            </option>
            @foreach (var address in addresses)
            {
                <option value="@address">@address</option>
            }

        </select>
    </div>

    <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" class="form-control" id="email" value= "@Model?.Email" aria-describedby="emailHelp"  name = "Email" placeholder="Enter email">
        <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
    </div>
    <div class="form-group">
        <label for="Image">Image linke</label>
        <input type="url" value="@Model?.Image"  class="form-control" id="Image" name="Image" required>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
</form>