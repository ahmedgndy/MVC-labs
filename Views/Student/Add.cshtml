@using MVc.Enums
@using MVc.Models
@using MVc.ViewModels

@{
    Layout = "_layout";

    ViewData["Title"] = "Studend";
}
@{
    var addresses = Enum.GetValues(typeof(Branch));

}

@model Stduent


<form class="m-5" action="/student/AddnewStudent" method="post">
    <div class="form-group">
        <label  asp-for="Name" ></label>
        <input  class="form-control" asp-for="Name"  aria-describedby="emailHelp">
    </div>

    <div class="form-group">
        <label for="Age"> Age </label>
        <input class="form-control" asp-for="Age"  required>
    </div>

    <div class="form-group">
        <label for="address">address</label>
        <select class="form-select" aria-label="Address" asp-for="Address" required>
            <option selected>
                @Model?.Address
            </option>
            @foreach (var address in addresses)
            {
                <option value="@address">@address</option>
            }

        </select>
    </div>
   

    <div class="form-group">
        <label for="email">Email address</label>
        <input  class="form-control"  asp-for="Email" aria-describedby="emailHelp"  placeholder="Enter email">
    </div>
    <div class="form-group">
        <label for="Image">Image linke</label>
        <input  class="form-control"  asp-for="Image"  required>
    </div>

    <div class="form-group">
        <label for="checkbox"> Enored Coursed </label>

        @for (var i = 0 ; i < Model.Courses.Count() ; i++)
        {

            <input class="form-check-input" type="checkbox" id="flexCheckDefault" asp-for="Courses[i].IsSelected"  ) />
            <label class="form-check-label" for="flexCheckDefault">
                @Model.Courses[i].Name 
            </label>

            <!-- Hidden fields for Id and Name so they post back -->
            <input type="hidden" asp-for="Courses[i].Id" />
            <input type="hidden" asp-for="Courses[i].Name" />
        }
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
</form>