@using MVc.Models
@model Student
@{
	ViewData["Title"] = "Student Details";
}
<h1>@Model.Name</h1>
<div>
	<dl class="row">
		<dt class="col-sm-2">Email</dt>
		<dd class="col-sm-10">@Model.Email</dd>


		<dt class="col-sm-2">DOB</dt>
		<dd class="col-sm-10">@Model.DateOfBirth.ToShortDateString()</dd>


		<dt class="col-sm-2">Department</dt>
		<dd class="col-sm-10">@Model.Department?.Name</dd>
	</dl>
</div>
<p><a class="btn btn-secondary" href="/Student">Back to list</a></p>