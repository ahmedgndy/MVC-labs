@using MVc.Models
@model IEnumerable<Student>
@{
	ViewData["Title"] = "Students";
}
<h1>Students</h1>
<p><a class="btn btn-primary" href="/Student/Create">Create New</a></p>
<table class="table table-striped">
	<thead>
		<tr><th>Name</th><th>Email</th><th>Department</th><th></th></tr>
	</thead>
	<tbody>
		@foreach (var s in Model)
		{
			<tr>
				<td>@s.Name</td>
				<td>@s.Email</td>
				<td>@s.Department?.Name</td>
				<td>
					<a class="btn btn-sm btn-info" href="/Student/Details/@s.Id">Details</a>
					<a class="btn btn-sm btn-warning" href="/Student/Edit/@s.Id">Edit</a>
					<a class="btn btn-sm btn-danger" href="/Student/Delete/@s.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>